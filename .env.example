# Copy to .env and customize. Never commit the real .env.
DOMAIN=home.lan
EMAIL=admin@example.com
TZ=UTC
MEDIA_DIR=/srv/media

# Database passwords (use strong, generated values).
MARIADB_ROOT_PASSWORD=changeme-root
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=changeme-nc-db

JOPLIN_DB_USER=joplin
JOPLIN_DB_PASSWORD=changeme-joplin-db

# Vaultwarden admin token.
VAULTWARDEN_ADMIN_TOKEN=changeme-admin

# Watchtower notifications (optional).
WATCHTOWER_WEBHOOK=
